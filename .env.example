# ===== LLM =====
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# 各阶段可独立指定 Provider（不填则回退到 LLM_*）
NPC_LLM_PROVIDER=
NPC_LLM_TIMEOUT=120
VISUAL_PROMPT_LLM_PROVIDER=
VISUAL_PROMPT_LLM_TIMEOUT=120
WORLD_BUILDER_LLM_PROVIDER=
WORLD_BUILDER_LLM_MAX_RETRIES=3
WORLD_BUILDER_LLM_TIMEOUT=120

# ===== Embedding =====
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ===== Memory / Vector =====
MEMORY_PROVIDER=in_memory

# ===== 图像生成（可选，资产生成阶段使用）=====
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=
# IMAGE_BASE_URL=
# IMAGE_MODEL=

# ===== 其他 =====
PIPELINE_CONFIG_PATH=data/pipeline_config.json
REMBG_AUTO_DOWNLOAD=0
